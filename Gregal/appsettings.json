{
  "GeneralSettings": {
    "LogPath": "gregal.log",
    "EnableAutoRefresh": true,
    "CsvSeparator": ";"
  },
  "NetworkSettings": {
    // Activa este protocolo (JSON/CSV, por TCP y RS232 a la vez). A false
    // porque hoy el receptor principal es el de TagProtocolSettings.
    "Enabled": false,
    "Mode": "hybrid",
    // Parámetros Canal TCP
    "TcpPort": 8080,
    "TcpAddress": "0.0.0.0",
    "AllowedIps": [ "127.0.0.1" ],
    "TcpKeepAliveTime": 60,
    "TcpKeepAliveInterval": 10,
    "TcpReadTimeoutMinutes": 5,
    "TcpMaxBufferChars": 16192,

    // Parámetros Canal Serie RS232 (Ampliados)
    "ComPort": "COM8",
    "BaudRate": 9600,
    "SerialDelimiter": "\u0000",
    // "None" por defecto: compatible con la mayoría del hardware RS232 (no todas las salas
    // tienen RTS/CTS cableado). Si una sala concreta lo necesita, se puede cambiar aquí.
    "SerialHandshake": "None",
    "SerialRtsEnable": true,
    "SerialDtrEnable": true,
    "SerialReadTimeoutMs": 1000,
    "SerialWriteTimeoutMs": 1000,
    "SerialReadBufferSize": 4096,
    "SerialWriteBufferSize": 4096,
    "SerialDataBits": 8,
    "SerialParity": "None", // Puede ser: None, Odd, Even, Mark, Space
    "SerialStopBits": "One", // Puede ser: None, One, Two, OnePointFive
    "SerialEncoding": "UTF-8" // Puede ser: UTF-8, ASCII, ISO-8859-1, etc.
  },
  "DatabaseSettings": {
    // Tabla destino. Debe tener las mismas columnas que HISTORICO.
    "TableName": "HISTORICO",
    // Longitud de la columna BOLAS de esa tabla. Si la lista de bolas de una
    // partida no cabe (hacia 86 bolas o más), se guardan las primeras y se
    // anota "BOLAS RECORTADAS" en RECLAMACION (la lista completa queda en el
    // log). 255 = tamaño original; 300 si se aplicó la migración de BOLAS.
    "MaxLongitudBolas": 255,
    // Charset=ISO8859_1 explícito: coincide con el charset real de la base
    // de datos (comprobado con RDB$CHARACTER_SET_NAME). Sin esto, el driver
    // conecta con "NONE" por defecto, que no traduce acentos/ñ y puede
    // corromper texto al guardarlo o leerlo (p.ej. en RECLAMACION).
    "ConnectionString": "User=SYSDBA;Password=griton;Database=C:\\CSHARP\\Gregal\\Gregal\\Gregal\\Data\\GREGAL_EMPTY.FDB;DataSource=localhost;Port=3050;Dialect=3;Charset=ISO8859_1"
  },
  // Protocolo de eventos "tag" (*CODIGO<valor>#) del software de pantallas
  // PidFullHD. Puerto COM propio, distinto del de NetworkSettings (no se
  // mezclan los dos protocolos en la misma conexión serie).
  "TagProtocolSettings": {
    // Activa este protocolo (eventos por RS232). Es el receptor principal hoy.
    "Enabled": true,
    "ComPort": "COM9",
    "BaudRate": 9600,
    "FrameDelimiter": "#",
    // Si una partida completa no se puede guardar en Firebird (p.ej. una
    // ráfaga de partidas más rápida de lo que la BBDD aguanta), se anexa aquí
    // en vez de perderse, para reimportarla a mano más tarde.
    "FallbackFilePath": "logs/historico_pendientes_tag.jsonl",
    // CodSala/CodConc: el protocolo no los lleva. Puestos a 1/1 de momento
    // para poder probar el guardado real en Firebird; cuando se despliegue en
    // una sala de verdad, cambia esto por sus valores reales.
    "DefaultCodSala": 1,
    "DefaultCodConc": 1,
    // Transcribe en el log cada fragmento *CODIGO<valor># tal cual llega.
    // Déjalo en true al probar por primera vez en una sala; pásalo a false
    // una vez confirmado el protocolo real (es una línea por evento).
    "LogRawFrames": true,
    // Fabricante del hardware de la sala: "Metronia" o "MCB". En MCB los
    // códigos A, M y p son ruido del hardware y se ignoran (aunque estén en
    // PremioCodeMap); en Metronia son premios reales.
    "Fabricante": "Metronia",
    // Letra de código -> índice 0-based en HistoricoDTO.Premios (Premios[i] =
    // columna PREMIO{i+1}): PREMIO1=línea (L), PREMIO2=bingo (B), PREMIO5=
    // línea plus (p), PREMIO6=prima (A), PREMIO7=bola tope de prima (M).
    // p/A/M solo se usan con Fabricante "Metronia".
    "PremioCodeMap": {
      "L": 0,
      "B": 1,
      "p": 4,
      "A": 5,
      "M": 6
    },
    // Código del evento J (longitud de serie) -> letra de edición del
    // cartón. Confirmado con tickets reales: J=3864 imprime "EB", J=3870 "EC".
    "SerieLetraMap": {
      "3864": "EB",
      "3870": "EC"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}