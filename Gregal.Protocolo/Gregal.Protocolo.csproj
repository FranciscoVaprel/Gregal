<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lo que hace falta para reconstruir partidas del protocolo tag
       (*CODIGO<valor>#) sin el servicio: parser de eventos, acumulador de
       partida, DTO, paso a columnas de HISTORICO y reproducción de un log de
       Gregal. Lo usan Gregal y BingoHistoricoEditor (importar un log), para
       que las reglas del protocolo estén en un único sitio. Sin dependencias
       de puerto serie, Firebird ni hosting. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gregal</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.4" />
  </ItemGroup>

</Project>
